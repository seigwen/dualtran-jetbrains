<idea-plugin>
  <id>dev.seigwen.dualtran</id>
  <name>DualTran Translate</name>
  <vendor>seigwen</vendor>

  <description><![CDATA[
    Translate the selected text without leaving the editor. Google Translate works with no key;
    any OpenAI-compatible endpoint works with your own key (BYOK), including a local Ollama.
  ]]></description>

  <resource-bundle>messages.DualTranBundle</resource-bundle>

  <depends>com.intellij.modules.platform</depends>

  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceImplementation="dev.seigwen.dualtran.DualTranSettings"/>
    <applicationConfigurable parentId="tools"
                             id="dev.seigwen.dualtran.settings"
                             displayName="DualTran"
                             instance="dev.seigwen.dualtran.DualTranConfigurable"/>
    <notificationGroup id="DualTran" displayType="BALLOON"/>
  </extensions>

  <actions>
    <action id="DualTran.TranslateSelection"
            class="dev.seigwen.dualtran.TranslateAction"
            text="translateAction"
            description="translateDescription">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
      <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt T"/>
    </action>
  </actions>
</idea-plugin>
